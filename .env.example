OPENROUTER_API_KEY=
# Or use Anthropic directly:
# ANTHROPIC_API_KEY=
# Override the extraction model for the server (CLI: --model). Default is Sonnet 5.
# AUTOFLOW_MODEL=openai/gpt-5.4-mini
# Live transcription of the room's audio. Without it the server runs, and audio connections are refused.
# DEEPGRAM_API_KEY=
